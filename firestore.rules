rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者判定の単一情報源（このファイル内）。
    // Firestore ルールは環境変数を参照できないためメールはリテラル必須だが、
    // 重複を避けここ1箇所に集約する。クライアントは src/utils/admin.ts、
    // サーバーは Vercel env ADMIN_EMAIL/ADMIN_UID が別の情報源。
    // admin.ts ↔ このファイルの齟齬は admin-drift テストが検知する。
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sushi.ramen.unajyu@gmail.com';
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /slots/{slotId} {
      allow read: if true;
      // 書き込みは管理者のみ。予約作成/キャンセル時の isBooked 更新はサーバー API
      // （Admin SDK・ルールをバイパス）が行う。以前の「認証ユーザーは isBooked のみ更新可」は
      // 任意スロットの予約状態を改ざんできる穴だったため廃止（★2026-05-30）。
      allow write: if isAdmin();
    }

    // レート制限カウンタ。サーバー（Admin SDK）専用。クライアントからは読み書き不可。
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /pushSubscriptions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /community_members/{email} {
      // 本人確認（メールアドレスのURLデコード後と一致）または管理者のみ読み取り可
      allow read: if isAdmin()
        || (request.auth != null
            && request.auth.token.email.lower() == email.lower());
      // 書き込みは管理者のみ
      allow write: if isAdmin();
    }

    // アプリ全体のメンテナンスモード状態。未ログイン含む全員が読み取り可、書き込みは管理者のみ。
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 一時トークルーム（2026-08-29 追加・期間限定の間借り）───────────────
    // 🔴 **ここだけログイン不要で読み書きできる**。守りは「部屋IDを知っていること」だけ。
    //    LINEが使えない相手との一時的なやり取り用で、重要な内容は置かない前提の割り切り。
    //    🔴 部屋IDは**ここ（ルール）とURLにしか無い**。クライアントのコードには書かない
    //       （ぽいロボは公開サイトなので、定数で持つと配信JSを読むだけで入れてしまう）。
    //       ルールはクライアントに配られないので、ここが唯一の突き合わせ先になる。
    //    🔵 経緯＝最初はIDを定数で持っていて公開JSに出てしまい、一度IDを変えた。
    //       ただし既に配ったURLが使えなくなるため、**元のIDに戻した**（露出は約10分・
    //       そのバンドルは既に配信されていない・中身は一時的な雑談のみ、という判断）。
    //       リダイレクトにすると新IDをコードに書く必要があり、同じ穴が空くので採らない。
    // 🔴 **期限つき**＝2026-10-08 を過ぎたら誰も読み書きできない（消し忘れの保険）。
    //    片付けるときはこの match ブロックごと削除し、Firestore の talkRooms も消す。
    function inTalkRoom(roomId) {
      return roomId == 'd9a0bd2484b7b12af28ffa164f141507'
        && request.time < timestamp.date(2026, 10, 8);
    }

    // 🔴 2026-08-31：**端末の制限も合言葉もやめた**（運用者の判断）。
    //    「検索から来ることはまず無いし、万が一見られても機密は置いていない」ため、
    //    URLを知っている人＝書ける、にする。**部屋ID（32桁）と期限が唯一の守り**。
    //
    //    やめた理由（実際に2回踏んだ）＝端末IDはブラウザの設定ひとつで変わる。
    //    ①一覧方式：変わった本人が締め出され、**新しいIDを伝える手段が無い**（このトークが唯一の連絡路）。
    //    ②合言葉方式：localStorage を保存できない端末だと**IDが毎回変わり**、
    //      合言葉を入れても入れ直しの無限ループになる。
    //    守るものの重さに対して、締め出しの事故のほうが高くついた。
    //
    //    🔵 締めたくなったら、この下の3つ（messages / images / members）の書き込み条件に
    //       身元の判定を戻す。**そのときは必ず「入れなくなった人の逃げ道」も一緒に用意すること**。

    match /talkRooms/{roomId} {
      allow read: if inTalkRoom(roomId);
      allow write: if false;   // 部屋そのものの書き換えは誰にも要らない

      // 🔵 合言葉の登録場所（keys）は役目を終えたので閉じた。残っている中身は誰にも読めない。
      match /keys/{uid} {
        allow read, write: if false;
      }

      match /messages/{msgId} {
        allow read: if inTalkRoom(roomId);
        allow create, update, delete: if inTalkRoom(roomId);
      }
      // 画像は本文とセットで作る。送り主を書かせて、同じ顔ぶれだけに絞る
      match /images/{imgId} {
        allow read: if inTalkRoom(roomId);
        allow create, update, delete: if inTalkRoom(roomId);
      }
      // 在席と既読。ドキュメントIDがそのまま端末ID
      match /members/{memId} {
        allow read: if inTalkRoom(roomId);
        allow write: if inTalkRoom(roomId);
      }
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      // 正規の予約作成はサーバー API（Admin SDK・ルールをバイパス）経由。
      // クライアント直書きは多層防御として厳格化: 本人の userId・status=pending・必須フィールドを要求。
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['userId', 'slotId', 'date', 'startTime', 'status']);
      // 更新は管理者のみ（confirm/complete）。本人の cancel はサーバー API
      // （Admin SDK・ルールをバイパス）が行う。本人のクライアント直更新を許すと
      // status を自己承認(confirmed)へ書き換えてコネクト権限を不正取得できる穴になるため、
      // 本人句を廃止（★2026-06-01）。
      allow update: if isAdmin();
    }

  }
}
