rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者判定の単一情報源（このファイル内）。
    // Firestore ルールは環境変数を参照できないためメールはリテラル必須だが、
    // 重複を避けここ1箇所に集約する。クライアントは src/utils/admin.ts、
    // サーバーは Vercel env ADMIN_EMAIL/ADMIN_UID が別の情報源。
    // admin.ts ↔ このファイルの齟齬は admin-drift テストが検知する。
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sushi.ramen.unajyu@gmail.com';
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /slots/{slotId} {
      allow read: if true;
      // 書き込みは管理者のみ。予約作成/キャンセル時の isBooked 更新はサーバー API
      // （Admin SDK・ルールをバイパス）が行う。以前の「認証ユーザーは isBooked のみ更新可」は
      // 任意スロットの予約状態を改ざんできる穴だったため廃止（★2026-05-30）。
      allow write: if isAdmin();
    }

    // レート制限カウンタ。サーバー（Admin SDK）専用。クライアントからは読み書き不可。
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /pushSubscriptions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /community_members/{email} {
      // 本人確認（メールアドレスのURLデコード後と一致）または管理者のみ読み取り可
      allow read: if isAdmin()
        || (request.auth != null
            && request.auth.token.email.lower() == email.lower());
      // 書き込みは管理者のみ
      allow write: if isAdmin();
    }

    // アプリ全体のメンテナンスモード状態。未ログイン含む全員が読み取り可、書き込みは管理者のみ。
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 一時トークルーム（2026-08-29 追加・期間限定の間借り）───────────────
    // 🔴 **ここだけログイン不要で読み書きできる**。守りは「部屋IDを知っていること」だけ。
    //    LINEが使えない相手との一時的なやり取り用で、重要な内容は置かない前提の割り切り。
    //    🔴 部屋IDは**ここ（ルール）とURLにしか無い**。クライアントのコードには書かない
    //       （ぽいロボは公開サイトなので、定数で持つと配信JSを読むだけで入れてしまう）。
    //       ルールはクライアントに配られないので、ここが唯一の突き合わせ先になる。
    //    🔵 経緯＝最初はIDを定数で持っていて公開JSに出てしまい、一度IDを変えた。
    //       ただし既に配ったURLが使えなくなるため、**元のIDに戻した**（露出は約10分・
    //       そのバンドルは既に配信されていない・中身は一時的な雑談のみ、という判断）。
    //       リダイレクトにすると新IDをコードに書く必要があり、同じ穴が空くので採らない。
    // 🔴 **期限つき**＝2026-10-08 を過ぎたら誰も読み書きできない（消し忘れの保険）。
    //    片付けるときはこの match ブロックごと削除し、Firestore の talkRooms も消す。
    function inTalkRoom(roomId) {
      return roomId == 'd9a0bd2484b7b12af28ffa164f141507'
        && request.time < timestamp.date(2026, 10, 8);
    }

    // 🔴 2026-08-30 追加＝**書き込めるのはいまやり取りしている端末だけ**（運用者の指示
    //    「既にチャットしている2名以外のブラウザはブロックしてOK」）。
    //    ログインしないので身元は端末ID（localStorage の talk.uid）しかない。それを
    //    **ルール側に列挙**する＝クライアントのコードには出さない（公開JSに出ないため、
    //    部屋IDと同じ扱いにできる）。
    //    🔵 1人につき2つあるのは、途中でブラウザ/履歴が変わって別IDになったため。
    //    🔵 'ai-assistant' は左下のAIボタンが投稿するときの送り主。
    //    🔴 **読み取りは止められない**（無認証なので端末を見分ける材料が読み取り時に無い）。
    //       URLを知られた場合、見られる可能性は残る＝重要な内容は置かない、は変わらない。
    //    🔴 端末を替える／履歴を消すと新しいIDになり**本人が書けなくなる**。
    //       そのときはここに1行足して `firebase deploy --only firestore:rules`。
    //    🔴🔴 2026-08-30 夕方＝**一時的に開けている**。nami の端末IDが変わって締め出され、
    //       締め出されると本人が新しいIDを伝える手段が無い（このトークが唯一の連絡路のため）。
    //       手順＝①ここを true にして開ける ②本人に開いてもらい members に新しい uid が入る
    //       ③その uid を下の一覧に足す ④`OPEN_FOR_NEW_DEVICE` を false に戻して閉じる。
    //       **③④を必ずやること**（開けたままにしない）。
    function talkerAllowed(uid) {
      return OPEN_FOR_NEW_DEVICE() || uid in [
        'aed12a7e4fb0a2fb83ec5311',   // ひろ（8/29の端末）
        'da2f0c088d2bb34b024024fe',   // ひろ（いま使っている端末）
        '6a24426a3d6dd73786f3b085',   // nami（8/30朝までの端末）
        '99c94419d5d91df91a6b8534',   // nami（8/30昼までの端末）
        'ai-assistant'                // AIの発言
      ];
    }

    /**
     * 新しい端末を迎え入れるための一時開放。閉じるときは false に戻す。
     * 🔵 合言葉方式（下の keys）を入れたので、通常は false のままでよい。
     */
    function OPEN_FOR_NEW_DEVICE() {
      return false;
    }

    /**
     * 🔴 2026-08-30 夜＝**合言葉で自分を登録できる**ようにした。
     *    端末IDだけの一覧にすると、ブラウザの設定ひとつでIDが変わって締め出され、
     *    しかも**本人が新しいIDを伝える手段が無い**（このトークが唯一の連絡路）。
     *    そこで「合言葉を知っていれば、その端末を自分で登録できる」形にする。
     *
     * 🔴 **`keys` は読み取り禁止**。合言葉が保存されても誰にも読めない
     *    （部屋の読み取りは無認証で誰でもできるので、読める場所に置くと意味が無くなる）。
     * 🔵 合言葉はここ（ルール）にだけ置く。クライアントのコードには書かない＝部屋IDと同じ扱い。
     */
    function talkPass() {
      return 'かめさん';
    }

    /**
     * 🆕 2026-08-31：**書き方のゆれを許す**（nami が「かめさんでは入れない」と言ってきたため）。
     *    合言葉は口頭・メッセージで伝わるので、変換で「カメさん」「亀さん」になるのが普通。
     *    完全一致だけにすると、本人なのに入れない＝また詰む。
     * 🔵 前後の空白は落とす（スマホは末尾に空白が入りやすい）。
     * 🔴 それでも「知っている人だけ」であることは変わらない（総当たりで当たる語ではない）。
     */
    function talkPassOk(v) {
      return v is string
        && v.trim() in ['かめさん', 'カメさん', 'ｶﾒさん', '亀さん', 'かめサン', 'kamesan', 'Kamesan', 'KAMESAN'];
    }

    function talkRegistered(roomId, uid) {
      return uid == 'ai-assistant'
        || exists(/databases/$(database)/documents/talkRooms/$(roomId)/keys/$(uid));
    }

    function canTalk(roomId, uid) {
      return talkerAllowed(uid) || talkRegistered(roomId, uid);
    }

    match /talkRooms/{roomId} {
      allow read: if inTalkRoom(roomId);
      allow write: if false;   // 部屋そのものの書き換えは誰にも要らない

      // 合言葉で自分の端末を登録する場所。**読めない・消せない**
      match /keys/{uid} {
        allow read, delete: if false;
        allow create, update: if inTalkRoom(roomId) && talkPassOk(request.resource.data.k);
      }

      match /messages/{msgId} {
        allow read: if inTalkRoom(roomId);
        allow create, update: if inTalkRoom(roomId) && canTalk(roomId, request.resource.data.uid);
        allow delete: if inTalkRoom(roomId) && canTalk(roomId, resource.data.uid);
      }
      // 画像は本文とセットで作る。送り主を書かせて、同じ顔ぶれだけに絞る
      match /images/{imgId} {
        allow read: if inTalkRoom(roomId);
        allow create, update: if inTalkRoom(roomId) && canTalk(roomId, request.resource.data.uid);
        allow delete: if inTalkRoom(roomId) && canTalk(roomId, resource.data.uid);
      }
      // 在席と既読。ドキュメントIDがそのまま端末ID
      match /members/{memId} {
        allow read: if inTalkRoom(roomId);
        allow write: if inTalkRoom(roomId) && canTalk(roomId, memId);
      }
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      // 正規の予約作成はサーバー API（Admin SDK・ルールをバイパス）経由。
      // クライアント直書きは多層防御として厳格化: 本人の userId・status=pending・必須フィールドを要求。
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['userId', 'slotId', 'date', 'startTime', 'status']);
      // 更新は管理者のみ（confirm/complete）。本人の cancel はサーバー API
      // （Admin SDK・ルールをバイパス）が行う。本人のクライアント直更新を許すと
      // status を自己承認(confirmed)へ書き換えてコネクト権限を不正取得できる穴になるため、
      // 本人句を廃止（★2026-06-01）。
      allow update: if isAdmin();
    }

  }
}
