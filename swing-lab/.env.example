# コピーして .env を作る（.env は git に入らない）
ANTHROPIC_API_KEY=sk-ant-...

# Discord（DISCORD.md 1章）: チャンネルごとに別々の Webhook を発行して貼る。
# 🔴 このURLを知っている人は誰でもそのチャンネルに投稿できる＝パスワード扱い。
#    発行: チャンネルの ⚙ → 連携サービス → ウェブフック → 新しいウェブフック → URLをコピー
DISCORD_WEBHOOK_DECISIONS=      # #判断サマリ（日次・引け後）
DISCORD_WEBHOOK_FILLS=          # #約定・保有（日次・引け後）
DISCORD_WEBHOOK_PERFORMANCE=    # #成績（週次）
DISCORD_WEBHOOK_ERRORS=         # #エラー・異常（イベント時のみ）

# note新着（NOTE_FEED.md・おまけ機能。トレードの4チャンネルとは別）
DISCORD_WEBHOOK_NOTE=
