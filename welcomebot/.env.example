# コピーして .env を作る（.env は git に入らない）

# 🔴 Discord Developer Portal → Bot → Reset Token で取得
#    同じ画面で **SERVER MEMBERS INTENT** をONにする（無いと参加を検知できない）
DISCORD_BOT_TOKEN=

# 歓迎文を投げる Webhook（#やぁ諸君！ の「ハカセ」）
# 🔵 Bot 自身には投稿権限を与えない。ここから投げるので要らない
WELCOME_WEBHOOK_URL=

# サーバーID（Discord で開発者モードON → サーバー名を右クリック → IDをコピー）
DISCORD_GUILD_ID=

# Bot が落ちていた間の参加を何日ぶんまで拾うか（既定14）
WELCOME_CATCH_UP_DAYS=14
