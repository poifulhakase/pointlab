{
  "name": "stock-calendar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-sw.mjs && tsc -b && vite build && node scripts/copy-static.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-jpx.mjs",
    "backtest": "node scripts/backtest-tev.mjs",
    "backtest-robo": "node scripts/backtest-robo.mjs",
    "robo-trade": "node scripts/robo-trade.mjs",
    "robo-outcome": "node scripts/robo-outcome.mjs",
    "fetch-momentum": "node scripts/fetch-poirobo-stocks.mjs",
    "notify-watch": "node scripts/notify-watch-alerts.mjs",
    "capture-chart": "node scripts/capture-tradingview.mjs",
    "add-participant": "node scripts/add-participants.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:booking": "node --env-file-if-exists=.env.e2e.local scripts/e2e-booking.mjs",
    "check-freshness": "node scripts/check-freshness.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@sentry/react": "^10.53.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^14.2.0",
    "jose": "^6.2.3",
    "lightweight-charts": "^5.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.12.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "//xlsx": "🔴 npm レジストリ版（0.18.5）は更新が止まっており Prototype Pollution / ReDoS が未修正。作者の公式配布（CDN 0.20.3）が修正版なので、そちらを直接指す（2026-08-16）。取得元が npm 以外になるので CI が落ちたらここを疑う。🔴 このコメントを dependencies の中に置くと npm が「//xlsx」というパッケージ名として読み、EINVALIDPACKAGENAME で install ごと落ちる（2026-08-16 に Vercel のデプロイを2回落とした）。コメントは必ずトップレベルに置くこと。",
  "//overrides": "🔴 uuid: firebase-admin の依存（gaxios / teeny-request）が古い uuid を掴んでおり moderate 6件の原因。上流の更新待ちにせず、ここで 11 系に寄せて解消する（2026-08-16）。",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@sentry/vite-plugin": "^5.3.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.0",
    "@vitejs/plugin-react": "^6.0.1",
    "adm-zip": "^0.5.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.62.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.7"
  }
}
